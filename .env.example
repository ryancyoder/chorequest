# Copy to .env for local dev. Both are safe to commit to a private repo and are
# baked into the built bundle by design — the publishable key identifies the
# project, and RLS is what actually guards the data.
#
# For the GitHub Pages build these must also exist as repository *variables*
# (Settings → Secrets and variables → Actions → Variables), because Vite reads
# them at build time, not at runtime.

VITE_SUPABASE_URL=https://uexmarficoqeifnpyphv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_C3xAfbiF-zPKT5ztLPhSOw_Q222ivsC
